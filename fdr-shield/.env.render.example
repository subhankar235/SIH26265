# Render backend environment template
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://HOST:6379/0
JWT_SECRET=replace-with-64-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-me
SUPER_ADMIN_SETUP_SECRET=replace-me
MFA_ENCRYPTION_KEY=replace-with-fernet-key
FRONTEND_ORIGIN=https://si-hh26265.vercel.app
S3_ENDPOINT=https://s3.amazonaws.com
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1
S3_BUCKET=fdr-documents
MOCK_BANK_URL=http://localhost:9100
SMTP_HOST=smtp.example.com
SMTP_PORT=587
TELEGRAM_BOT_TOKEN=
OCR_ENGINE=disabled
STORAGE_BACKEND=s3
CELERY_TASK_ALWAYS_EAGER=false
CORS_ORIGINS=https://si-hh26265.vercel.app
TRUSTED_PROXY_IPS=
COMMAND_LLM_ENABLED=false
RULES_DEFAULT_TZ=Asia/Kolkata
ML_ANOMALY_DEMO=false
